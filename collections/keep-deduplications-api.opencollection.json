            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Update Deduplication Rule"
        },
        {
          "info": {
            "name": "Delete Deduplication Rule",
            "type": "http"
