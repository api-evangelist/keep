{
  "opencollection": "1.0.0",
  "info": {
    "name": "Keep actions providers API",
    "version": "0.24.5"
  },
  "items": [
    {
      "info": {
        "name": "providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Providers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/providers",
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Get Providers"
        },
        {
          "info": {
            "name": "Get Installed Providers",
            "type": "http"
          },
          "http": {
