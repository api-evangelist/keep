          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/auth/users/:user_email",
            "params": [
              {
                "name": "user_email",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-KEY",
              "value": "{{X-API-KEY}}",
              "placement": "header"
            }
          },
          "docs": "Delete a user"
        }
      ]
    }
  ],
  "bundled": true
